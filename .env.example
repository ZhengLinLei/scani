# Docker Compose reads this file as .env; no shell sourcing is used.
# Host IP or DNS name used in the HTTPS certificate (no scheme or port).
SCANI_ADDRESS=localhost
# Production ports: HTTP is bound to host loopback; HTTPS is available on the LAN.
SCANI_PORT=3000
SCANI_HTTPS_PORT=8443
# Development ports. Choose another HTTPS port when production is also running.
SCANI_DEV_PORT=4200
SCANI_DEV_HTTPS_PORT=8443
# Models download once into the scans volume's ocr-cache directory.
OCR_LANGUAGES=eng+spa
# Maximum width of the OCR copy. High accuracy uses 2200; Faster is capped at 1600.
OCR_MAX_WIDTH=2200
# Reject uncertain nonblank OCR instead of saving likely noise (0–100).
OCR_MIN_CONFIDENCE=45
# Optional offline models inside the container; populate /app/data/languages first.
# OCR_LANG_PATH=/app/data/languages
# For direct Node development only (Docker Compose sets these internally):
# HOST=127.0.0.1
# PORT=3000
# DATA_DIR=./data
# TRUST_PROXY=0
